@if (Errors.Count > 0)
{
    <div class="error-summary" role="alert" tabindex="-1" id="error-summary">
        <strong>Der mangler lige noget:</strong>
        <ul>
            @foreach (var m in Errors.Select(e => e.Message).Distinct())
            {
                <li>@m</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ValidationError> Errors { get; set; } = [];
}
